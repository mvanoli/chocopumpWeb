{
  "name": "chocopump",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "chocopump.com", "custom_domain": true },
    { "pattern": "www.chocopump.com/*", "zone_name": "chocopump.com" }
  ],
  "vars": { "LEAD_TO": "info@chocopump.com" },
  "send_email": [
    { "name": "EMAIL", "allowed_destination_addresses": ["info@chocopump.com"] },
    { "name": "REPLY", "allowed_sender_addresses": ["info@chocopump.com"] }
  ],
  "observability": { "enabled": true }
}
